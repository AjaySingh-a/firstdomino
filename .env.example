# Copy to .env. Never commit .env.

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# --- API ---
FD_CORS_ORIGINS=http://localhost:3001
# graph = read and write FalkorDB (the docker compose default) | fixtures = in-memory stub
# (the default for a local `uvicorn` run)
# FD_STORE=graph
# FD_FAMILY=demo
# FD_STORIES=1 2 3
# FD_DATA_DIR=./data

# --- Web (read at build time) ---
# fixtures = read data/snapshots via web/lib/api.ts; live = call the API
NEXT_PUBLIC_DATA_SOURCE=fixtures
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Agent (Ajay) ---
# LLM_API_KEY=
# FD_AGENT_MODEL=

# Server-side API URL for the web container (docker compose sets http://api:8000)
# API_INTERNAL_URL=http://localhost:8000
